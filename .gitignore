# Python bytecode and caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, coverage, and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IDE and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local secrets and environment files
.env
.env.*
!.env.example

# Generated training runs (keep the pretrained final_exp assets)
NST_Code/experiment/experiment*/
NST_Code/experiment/*/args.txt

# Temporary uploads/results are generated at runtime
NST_Code/static/uploads/*
!NST_Code/static/uploads/.gitkeep
